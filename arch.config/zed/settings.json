// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "active_pane_modifiers": {
    "inactive_opacity": 1.0
  },
  "window_decorations": "server",
  "redact_private_values": true,
  "minimum_split_diff_width": 5.0,
  "diff_view_style": "unified",
  "outline_panel": {
    "dock": "left"
  },
  "collaboration_panel": {
    "dock": "left"
  },
  "git_panel": {
    "dock": "left"
  },
  "buffer_font_weight": 400.0,
  "buffer_line_height": "standard",
  "edit_predictions": {
    "provider": "zed"
  },
  "colorize_brackets": true,
  "format_on_save": "off",
  "drag_and_drop_selection": {
    "enabled": false
  },
  "sticky_scroll": {
    "enabled": true
  },
  "scroll_sensitivity": 1.0,
  "which_key": {
    "enabled": false
  },
  "show_edit_predictions": true,
  "languages": {
    "Python": {
      "format_on_save": "off"
    }
  },
  "agent": {
    "dock": "right",
    "tool_permissions": {
      "tools": {
        "terminal": {
          "always_allow": [
            {
              "pattern": "^gh\\b"
            }
          ]
        },
        "fetch": {
          "default": "allow"
        }
      }
    },
    "favorite_models": [
      {
        "provider": "copilot_chat",
        "model": "gpt-5.3-codex",
        "enable_thinking": false
      },
      {
        "provider": "copilot_chat",
        "model": "claude-opus-4.5",
        "enable_thinking": false
      },
      {
        "provider": "copilot_chat",
        "model": "gemini-3.1-pro-preview",
        "enable_thinking": false
      },
      {
        "provider": "copilot_chat",
        "model": "gpt-5.2-codex",
        "enable_thinking": false
      }
    ],
    "notify_when_agent_waiting": "all_screens",
    "inline_assistant_model": {
      "provider": "copilot_chat",
      "model": "grok-code-fast-1"
    },
    "default_model": {
      "provider": "copilot_chat",
      "model": "gpt-5.2-codex"
    },
    "model_parameters": []
  },
  "agent_ui_font_size": 16.0,
  "ui_font_family": "Hack Nerd Font",
  "wsl_connections": [
    {
      "distro_name": "arch",
      "user": null,
      "projects": [
        {
          "paths": ["/home/soham"]
        }
      ]
    }
  ],
  "buffer_font_family": "Symbols Nerd Font",
  "agent_servers": {
    "codex-acp": {
      "type": "registry"
    },
    "your_agent": {
      "type": "custom",
      "command": "path_to_executable",
      "args": [],
      "env": {}
    }
  },
  "terminal": {
    "font_size": 17.0,
    "font_family": "Hack Nerd Font Mono",
    "line_height": {
      "custom": 1.2
    },
    "copy_on_select": true
  },
  "project_panel": {
    "dock": "right",
    "auto_fold_dirs": false
  },
  "preview_tabs": {
    "enable_preview_from_file_finder": true
  },
  "search": {
    "include_ignored": false
  },
  "relative_line_numbers": "enabled",
  "gutter": {
    "line_numbers": true
  },
  "minimap": {
    "thumb_border": "right_open",
    "show": "always",
    "max_width_columns": 80
  },
  "hover_popover_delay": 500,
  "cursor_blink": false,
  "autosave": {
    "after_delay": {
      "milliseconds": 450
    }
  },
  "file_types": {
    "html": ["*.html"],
    "plaintext": [".env"]
  },
  "linked_edits": true,
  "preferred_line_length": 150,
  "soft_wrap": "prefer_line",
  "base_keymap": "VSCode",
  "session": {
    "trust_all_worktrees": true
  },
  "telemetry": {
    "diagnostics": true,
    "metrics": false
  },
  "vim_mode": true,
  "ui_font_size": 16.0,
  "buffer_font_size": 16.0,
  "theme": "VSCode Dark Polished"
}
