# Config syntax crash course
# ==========================
# # The config file consists of simple key-value pairs,
# # separated by equals signs.
# font-family = Iosevka
# window-padding-x = 2
#
# # Spacing around the equals sign does not matter.
# # All of these are identical:
# key=value
# key= value
# key =value
# key = value
#
# # Any line beginning with a # is a comment. It's not possible to put
# # a comment after a config option, since it would be interpreted as a
# # part of the value. For example, this will have a value of "#123abc":
# background = #123abc
background-opacity = 1
#
# # Empty values are used to reset config keys to default.
# key =
#
# # Some config options have unique syntaxes for their value,
# # which is explained in the docs for that config option.
# # Just for example:
# resize-overlay-duration = 4s 200ms

keybind = "ctrl+enter=ignore"
font-family = JetBrainsMono Nerd Font
font-style = Regular
font-size = 16
font-thicken = false
font-feature = -calt
adjust-cell-height = -10%
confirm-close-surface = false

# Theme
theme = /home/soham/.config/ghostty/themes/Elemental

# Prefix / ader configuration
# Note: Ghostty prefix sequences wait indefinitely for the next key

# New Splits (Horizontal and Vertical)
keybind = alt+i>v=new_split:right
keybind = alt+i>s=new_split:down

# Closing Panes (Splits)
keybind = alt+i>x=close_surface

# Pane Navigation (Vim-style)
keybind = alt+i>h=goto_split:left
keybind = alt+i>j=goto_split:bottom
keybind = alt+i>k=goto_split:top
keybind = alt+i>l=goto_split:right

# Pane Resizing
keybind = alt+i>shift+j=resize_split:down,30
keybind = alt+i>shift+k=resize_split:up,30
keybind = alt+i>shift+h=resize_split:left,30
keybind = alt+i>shift+l=resize_split:right,30

# Tab (Window) Management
keybind = alt+i>c=new_tab
keybind = alt+i>[=previous_tab
keybind = alt+i>]=next_tab

# Keymaps
keybind = ctrl+[=text:\x1b

# Scrolling
keybind = ctrl+shift+]=scroll_page_fractional:0.1
keybind = ctrl+shift+[=scroll_page_fractional:-0.1
