// This configuration is merged with the default vicinae configuration file, which you can obtain by running the `vicinae config default` command.
// Every item defined in this file takes precedence over the values defined in the default config or any other imported file.
//
// You can make manual edits to this file, however you should keep in mind that this file may be written to by vicinae when a configuration change is made through the GUI.
// When that happens, any custom comments or formatting will be lost.
//
// If you want to maintain a configuration file with your own comments and formatting, you should create a separate file and add it to the 'imports' array.
//
// Learn more about configuration at https://docs.vicinae.com/config

{
   "$schema": "https://vicinae.com/schemas/config.json",
   "close_on_focus_loss": true,
   "pop_to_root_on_close": false,
   "favicon_service": "twenty",
   "keybinding": "emacs",
   "font": {
      "rendering": "qt",
      "normal": {
         "family": "Material-Design-Iconic-Font",
         "size": 11
      }
   },
   "theme": {
      "dark": {
         "name": "vicinae-dark"
      }
   },
   "telemetry": {
      "system_info": false
   },
   "launcher_window": {
      "opacity": 1
   },
   "keybinds": {
      "toggle-action-panel": "control+B"
   },
   "favorites": [],
   "fallbacks": [
      "shortcuts:3183da21-1145-4683-8113-a199e2398666"
   ],
   "providers": {
      "@rithvikvibhu/store.vicinae.arch-packages": {
         "enabled": true
      },
      "applications": {
         "preferences": {
            "defaultAction": "focus",
            "paths": [
               "/home/soham/.local/share/applications",
               "/usr/share/applications"
            ]
         },
         "entrypoints": {
            "com.google.Chrome": {
               "enabled": false
            },
            "power-off": {
               "alias": "off"
            },
            "reboot": {
               "alias": "re"
            },
            "wiremix": {
               "enabled": false
            }
         }
      },
      "browser-extension": {
         "enabled": false
      },
      "power": {
         "enabled": true,
         "entrypoints": {
            "hibernate": {
               "enabled": false
            },
            "lock": {
               "enabled": false,
               "preferences": {
                  "customProgram": "hyprshutdown"
               }
            },
            "logout": {
               "enabled": false,
               "preferences": {
                  "confirm": false
               }
            },
            "power-off": {
               "enabled": false
            },
            "reboot": {
               "enabled": false
            },
            "sleep": {
               "enabled": true,
               "preferences": {
                  "confirm": true,
                  "customProgram": "systemctl suspend"
               }
            },
            "soft-reboot": {
               "enabled": false
            },
            "suspend": {
               "enabled": false
            }
         }
      },
      "system": {
         "entrypoints": {
            "run": {
               "alias": ">"
            }
         }
      }
   }
}