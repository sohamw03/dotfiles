[Desktop Entry]
Type=Application
Name=Restart Noctalia Shell
GenericName=Restart desktop shell
Comment=Safely restart the Noctalia shell (SIGTERM, wait for exit, SIGKILL fallback, then launch)
Exec=bash -c "pkill -x qs 2>/dev/null; timeout 5 sh -c 'until pgrep -x qs >/dev/null 2>&1; do sleep 0.1; done' || pkill -9 -x qs 2>/dev/null; sleep 0.2; uwsm app -- /usr/local/bin/qs -p /home/soham/dotfiles/shell &"
Icon=view-refresh
Terminal=false
Categories=System;
Keywords=shell;noctalia;quickshell;restart;reload;qs;
StartupNotify=false
