[Desktop Entry]
Type=Application
Name=Waydroid Start
GenericName=Start Waydroid Session
Comment=Start Waydroid session and show full UI (starts container if needed via pkexec)
Exec=bash -c "systemctl is-active --quiet waydroid-container.service || pkexec systemctl start waydroid-container.service; waydroid session start && waydroid show-full-ui"
Icon=waydroid
Terminal=false
Categories=System;
Keywords=waydroid;android;session;start;
StartupNotify=false
